@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ILogger<RichContent> Logger

<div class="blog-content" @ref="_container">
    @((MarkupString)_processedHtml)
</div>

@code {
    [Parameter, EditorRequired] public string Html { get; set; } = "";

    private ElementReference _container;
    private IJSObjectReference? _module;
    private string _processedHtml = "";
    private string? _sourceHtml;
    private bool _enhancementPending;

    protected override void OnParametersSet()
    {
        if (string.Equals(_sourceHtml, Html, StringComparison.Ordinal))
        {
            return;
        }

        _sourceHtml = Html;
        _processedHtml = HtmlPostProcessor.Process(Html);
        _enhancementPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_enhancementPending)
        {
            return;
        }

        _enhancementPending = false;
        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./Components/RichContent.razor.js");
            await _module.InvokeVoidAsync("enhance", _container);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Post-render content enhancement failed");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
